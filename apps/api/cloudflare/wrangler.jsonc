{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "treasurfy-mvp",
  "main": "worker.py",
  "workers_dev": true,
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "treasurfy-mvp",
      "database_id": "b7fe838e-39a2-4928-81e2-7db85a5fe2f9"
    }
  ],
  "observability": {
    "enabled": true
  }
}
